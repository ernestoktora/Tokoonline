)); stroke-width: 2; stroke-dasharray: 100.53, 100.53; stroke-dashoffset: 1=
00.53; animation: 1s linear 0s 1 normal forwards running rw-gp-animate-circ=
le; }

div[data-rewards-widget].medallion .gaining-points-animation .medal-svg-ani=
mation { position: relative; animation: 0.3s cubic-bezier(0.075, 0.82, 0.16=
