@keyframes rw-gp-animate-circle {=20
  100% { stroke-dashoffset: 0; }
}

@keyframes rw-gp-expand-collapse {=20
  0% { transform: scale(1); }
  70% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

div[data-rewards-widget].medallion .goal-tracking-container { width: 32px; =
height: 32px; }

