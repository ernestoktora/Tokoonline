0, 199, 255); }

#svctrlinlineform { background: var(--flyout-bg-clr); }

.b_scactive #svctrlhvrbtn:hover, .b_scactive #svctrlhvrpnlbtn:hover { curso=
r: pointer; background-color: rgb(244, 244, 244); }

.b_dark .b_scactive #svctrlhvrbtn:hover, .b_dark .b_scactive #svctrlhvrpnlb=
tn:hover { background-color: rgb(59, 58, 57); }

.b_scactive #svctrlhvrbtn:focus { cursor: pointer; background-color: rgb(24=
4, 244, 244); }

.b_svcitm[data-svd=3D"1"] .b_svcimg::after { background-image: var(--svicn-=
colpck); }

.b_svcitm:not([data-svd=3D"1"]):hover .b_svcimg::after { background-image: =
var(--unsvicn-colpck); }
